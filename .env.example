# ═══════════════════════════════════════════════
# Sales Insight Automator — Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in your actual keys.
# NEVER commit the real .env file to GitHub.

# ─── Backend (.env in /backend and root) ───

# Port the Express server runs on
PORT=5001

# Groq API key for AI summaries (get free at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Brevo API key for sending emails (get free at https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=your_brevo_api_key_here

# Brevo verified sender email (the email you signed up to Brevo with)
BREVO_SENDER_EMAIL=your_email@example.com

# Frontend URL (for CORS — update to your Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# Environment mode
NODE_ENV=development

# ─── Frontend (.env in /frontend) ───

# Backend API URL (update to your Render URL in production)
VITE_API_URL=http://localhost:5001
